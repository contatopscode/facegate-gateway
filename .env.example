# ====================================================================
# FaceGate Gateway — variáveis de ambiente
# Copie para .env e preencha com valores reais
# ====================================================================

# --- Auth (OBRIGATÓRIO) ---
# Token compartilhado com o FaceGate backend (header Authorization: Bearer)
# Gere um: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKEN=troque-por-um-token-aleatorio-32-chars

# --- Terminal Hikvision/Intelbras (OBRIGATÓRIO) ---
HIKVISION_HOST=10.5.50.161
HIKVISION_PORT=443
HIKVISION_USER=admin
HIKVISION_PASSWORD=troque-pela-senha-do-terminal
HIKVISION_FDID=1
HIKVISION_FACE_LIB_TYPE=blackFD

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
