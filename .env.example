# ====================================================================
# FaceGate Gateway — variáveis de ambiente
# Copie para .env e preencha com valores reais
# ====================================================================

# --- Auth (OBRIGATÓRIO) ---
# Token compartilhado com o FaceGate backend (header Authorization: Bearer)
# Gere um: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKEN=troque-por-um-token-aleatorio-32-chars

# --- Terminal Hikvision/Intelbras (OBRIGATÓRIO) ---
# Ex. validado na loja: DS-K1T672MX responde em http:80 (10.5.50.155).
HIKVISION_HOST=10.5.50.155
HIKVISION_PORT=80
# Esquema pra falar com o terminal: https (default de fábrica) ou http.
# Muitos DS-K1T3xx/6xx atendem ISAPI em http:80 — o DS-K1T672MX da loja
# respondeu em http:80. Se o seu só atende em texto claro, use http + porta 80.
HIKVISION_SCHEME=http
HIKVISION_USER=admin
HIKVISION_PASSWORD=troque-pela-senha-do-terminal
HIKVISION_FDID=1
HIKVISION_FACE_LIB_TYPE=blackFD

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Vários terminais na mesma LAN (opcional) ---
# JSON numa linha só. Cada leitor responde em /leitores/<nome>/hikvision/...
# e, no FaceGate, o device usa gateway_url = https://<túnel>/leitores/<nome>.
# Campos: host (obrigatório), port (443), scheme (https), user (admin),
# password, fdid (1), face_lib_type (blackFD). Nome: a-z, 0-9 e "-".
# As rotas /hikvision/... (sem nome) continuam no terminal HIKVISION_* acima.
# LEITORES={"bancada":{"host":"10.5.50.155","port":80,"scheme":"http","password":"..."},"lavanderia":{"host":"10.5.50.161","port":80,"scheme":"http","password":"..."}}
